# ==============================================================
# Environment Configuration Template
# Copy this file to ".env" and fill in real values.
# NEVER commit the actual ".env" file to GitHub.
# ==============================================================

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rpm_system
DB_USER=root
DB_PASSWORD=change_me

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_long_random_string

# --- Security ---
# Number of bcrypt hashing rounds (higher = slower but more secure)
BCRYPT_ROUNDS=12
SESSION_EXPIRY_MINUTES=60

# --- Risk Thresholds (used by risk_engine, tunable without code changes) ---
RISK_THRESHOLD_MEDIUM=0.4
RISK_THRESHOLD_HIGH=0.7
RISK_THRESHOLD_CRITICAL=0.9
